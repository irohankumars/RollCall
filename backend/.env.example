# Render production value: production
NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/rollcall.db
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
# Render production value: https://roll-call-three.vercel.app
CORS_ORIGIN=http://localhost:8083
# Optional development seed values
DEV_SEED_PASSWORD=
DEV_COLLEGE_NAME=Development College
DEV_LECTURER_LOGIN=lecturer@development.local
DEV_HOD_LOGIN=hod@development.local
DEV_COLLEGE_ADMIN_LOGIN=admin@development.local
DEV_SUPER_ADMIN_LOGIN=owner@development.local
PAYMENT_WEBHOOK_SECRET=replace-with-a-dedicated-payment-webhook-secret
# Render production value: https://roll-call-three.vercel.app/activate
ONBOARDING_BASE_URL=http://localhost:8083/activate
EXPOSE_DEV_ONBOARDING_SECRETS=false

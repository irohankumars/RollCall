NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/rollcall.db
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
CORS_ORIGIN=http://localhost:8081

# Optional development seed values. The seed command refuses to run without a password.
DEV_SEED_PASSWORD=
DEV_COLLEGE_NAME=Development College
DEV_LECTURER_LOGIN=lecturer@development.local
DEV_COLLEGE_ADMIN_LOGIN=admin@development.local
DEV_SUPER_ADMIN_LOGIN=owner@development.local
